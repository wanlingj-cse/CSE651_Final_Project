{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/menu", "destination": "/online/petersbakery", "permanent": true },
    { "source": "/menu.html", "destination": "/online/petersbakery", "permanent": true }
  ],
  "rewrites": [
    { "source": "/rewards", "destination": "/rewards.html" },
    { "source": "/online/petersbakery", "destination": "/online/petersbakery.html" },
    { "source": "/order.toasttab.com/online/petersbakery", "destination": "/online/petersbakery.html" },
    { "source": "/toasttab", "destination": "/online/petersbakery.html" },
    { "source": "/egiftcards/petersbakery", "destination": "/egiftcards/petersbakery.html" },
    { "source": "/order.toasttab.com/egiftcards/petersbakery", "destination": "/egiftcards/petersbakery.html" },
    { "source": "/petersbakery/giftcards", "destination": "/egiftcards/petersbakery.html" },
    { "source": "/egiftcards", "destination": "/egiftcards/petersbakery.html" },
    { "source": "/giftcards", "destination": "/egiftcards/petersbakery.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
